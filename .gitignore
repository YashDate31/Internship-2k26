# -----------------------------------------------------------------------------
# College Sahayak Internship Repository - .gitignore
# -----------------------------------------------------------------------------

# Dependencies
**/node_modules/
**/.npm/
**/.pnpm-store/
**/.yarn/

# Build outputs and caches
**/dist/
**/build/
**/.vite/
**/.parcel-cache/
**/.cache/

# Python environments & caches
.venv/
**/.venv/
__pycache__/
*.pyc

# Environment / secrets & API keys
.env
**/.env
*.env.local
serviceAccountKey.json
**/serviceAccountKey.json

# Logs & temporary files
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS & IDE System Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.user
